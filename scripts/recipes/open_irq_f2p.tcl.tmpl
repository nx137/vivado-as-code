# @desc 打开 PL→PS 中断：axi_intc + 常量占位（接入 PS 的 IRQ_F2P）
# 注意：PS 侧的 FABRIC_INTERRUPT/IRQ_F2P 开关也可以用 ps7.yaml 的 irq_f2p: true 统一管理
# @param intc_name=axi_intc_0 中断控制器实例名（PYNQ 侧按此名取 IP）
# @param tie_name=xlconstant_irq 占位常量（1 bit 0，接到 intc.intr，等用户换成真实中断源）
# @param addr=0x41800000 axi_intc 的 AXI-Lite 基地址
#
# 说明：
#   - axi_intc v4.1 只有 1 个 `intr` 输入引脚（没有 `clk` 引脚），
#     `C_NUM_INTR_INPUTS` 在 2020.2 里是只读属性，不能在 Tcl 里改；
#   - 多中断源的标准做法是在 GUI 里改 "Number of Interrupt Inputs" 并让各源分别接入
#     （或用 concat 后逐个连接，需在 GUI 完成）；
#   - 本 recipe 先用常量 0 占住 `intr`，使设计能通过 validate/门禁；
#     接入真实中断时：删掉 tie 常量 → 把中断源连到 @@intc_name@@/intr。
#
# 用法提示：
#   PYNQ 2.x 上 DMA 中断常不可用，实际读取建议轮询状态寄存器。

set _ps [get_bd_cells processing_system7_0]
set_property -dict [list \
    CONFIG.PCW_USE_FABRIC_INTERRUPT {1} \
    CONFIG.PCW_IRQ_F2P_INTR {1} \
] $_ps
puts "  \[recipe\] 已打开 PS 的 FABRIC_INTERRUPT / IRQ_F2P"

set _intc [vac_ensure_ip xilinx.com:ip:axi_intc:4.1 @@intc_name@@ {}]
set _tie  [vac_ensure_ip xilinx.com:ip:xlconstant:1.1 @@tie_name@@ {
    CONFIG.CONST_WIDTH {1}
    CONFIG.CONST_VAL {0}
}]

# ---- 时钟 / 复位 / 中断连线 ----------------------------------------------
vac_connect_net_if_free [list processing_system7_0/FCLK_CLK0 @@intc_name@@/s_axi_aclk]
if {[llength [get_bd_pins -quiet rst_ps7_0_100M/peripheral_aresetn]] > 0} {
    vac_connect_net_if_free [list rst_ps7_0_100M/peripheral_aresetn @@intc_name@@/s_axi_aresetn]
}
vac_connect_net_if_free [list @@tie_name@@/dout @@intc_name@@/intr]
vac_connect_net_if_free [list @@intc_name@@/irq processing_system7_0/IRQ_F2P]

# ---- AXI-Lite 控制通路：扩主互连 + 分地址 ---------------------------------
set _target [get_bd_intf_pins -quiet @@intc_name@@/s_axi]
if {[llength $_target] == 0} { fail "@@intc_name@@ 没有 s_axi 接口" }
set _already [expr {[llength [get_bd_intf_nets -quiet -of_objects $_target]] > 0}]
if {$_already} {
    puts "  \[recipe\] @@intc_name@@/s_axi 已连接，跳过扩互连与分地址"
} else {
    set mi_cur [get_property CONFIG.NUM_MI [get_bd_cells ps7_0_axi_periph]]
    set mi_new [expr {$mi_cur + 1}]
    set_property CONFIG.NUM_MI $mi_new [get_bd_cells ps7_0_axi_periph]
    set mi_idx [format "M%02d" [expr {$mi_new - 1}]]
    vac_connect_net_if_free [list processing_system7_0/FCLK_CLK0 ps7_0_axi_periph/${mi_idx}_ACLK]
    if {[llength [get_bd_pins -quiet rst_ps7_0_100M/peripheral_aresetn]] > 0} {
        vac_connect_net_if_free [list rst_ps7_0_100M/peripheral_aresetn ps7_0_axi_periph/${mi_idx}_ARESETN]
    }
    vac_connect_if_free [list ps7_0_axi_periph/${mi_idx}_AXI @@intc_name@@/s_axi]
    vac_ensure_addr @@addr@@ 0x10000 processing_system7_0/Data @@intc_name@@/s_axi/Reg
}

vac_verify_prop processing_system7_0 CONFIG.PCW_IRQ_F2P_INTR {1}
puts "  \[recipe\] 接入真实中断时：删掉 @@tie_name@@，把中断源连到 @@intc_name@@/intr"
