# @desc 修改 PS 的 FCLK 频率（post-BD 脚本；只改配置、不改 BD 结构）
# @param fclk=150 目标频率（MHz）
# @param index=0 FCLK 编号（0..3）
#
# 说明：
#   - 只写"用户意图"属性 PCW_FPGA<n>_PERIPHERAL_FREQMHZ，Vivado 会自动重算分频；
#   - 这里会回读 ACT 值做数值校验（不是字符串比较）；
#   - BD 里的 FCLK 只是设计值，板上实际频率由 FSBL 决定——软件侧 FS 要按实测校准。

set _ps [get_bd_cells processing_system7_0]
set_property CONFIG.PCW_FPGA@@index@@_PERIPHERAL_FREQMHZ {@@fclk@@} $_ps

set _act [get_property CONFIG.PCW_ACT_FPGA@@index@@_PERIPHERAL_FREQMHZ $_ps]
set _div0 [get_property CONFIG.PCW_FCLK@@index@@_PERIPHERAL_DIVISOR0 $_ps]
set _div1 [get_property CONFIG.PCW_FCLK@@index@@_PERIPHERAL_DIVISOR1 $_ps]
puts "  \[recipe\] FCLK@@index@@: 请求 @@fclk@@ MHz -> ACT=$_act MHz (DIV $_div0/$_div1)"

if {abs(double($_act) - @@fclk@@) > 0.01} {
    fail "FCLK@@index@@ 实际为 $_act MHz，与请求 @@fclk@@ MHz 不符（检查 PLL/分频是否可达）"
}
