# @desc 添加第二个 AXI DMA，独占一个 S_AXI_HP 口与独立 interconnect（避免扩 NUM_SI 的坑）
# @param name=axi_dma_1 实例名
# @param hp_index=1 使用的 HP 口编号（0..3）
# @param data_width=32 数据位宽
# @param length_width=26 传输长度寄存器位宽（26 => 单次 64MB）
# @param addr=0x40410000 AXI-Lite 基地址
# @param loopback=1 1=MM2S 先自环回 S2MM（保证可直接构建）；接真实数据流时设 0

set dma [vac_ensure_ip xilinx.com:ip:axi_dma:7.1 @@name@@ {
    CONFIG.c_include_sg {0}
    CONFIG.c_sg_include_stscntrl_strm {0}
    CONFIG.c_sg_length_width {@@length_width@@}
    CONFIG.c_include_mm2s {1}
    CONFIG.c_include_s2mm {1}
    CONFIG.c_m_axi_mm2s_data_width {@@data_width@@}
    CONFIG.c_s_axis_s2mm_tdata_width {@@data_width@@}
}]

vac_require_cell processing_system7_0
set _ps [get_bd_cells processing_system7_0]

# ---- 打开 HP 口（PS 侧）---------------------------------------------------
set_property CONFIG.PCW_USE_S_AXI_HP@@hp_index@@ {1} $_ps
puts "  \[recipe\] 已启用 processing_system7_0/S_AXI_HP@@hp_index@@"

# ---- 独立数据互连：2 主口 -> 1 从口 --------------------------------------
set _mem_name axi_mem_intercon_hp@@hp_index@@
set _mem [vac_ensure_ip xilinx.com:ip:axi_interconnect:2.1 $_mem_name {
    CONFIG.NUM_SI {2}
    CONFIG.NUM_MI {1}
}]

# ---- 时钟 / 复位 ----------------------------------------------------------
# 注意：必须用 [list ...] 而不是 { ... }，否则 ${_mem_name} 不会被展开
foreach _p [list \
    @@name@@/s_axi_lite_aclk \
    @@name@@/m_axi_mm2s_aclk \
    @@name@@/m_axi_s2mm_aclk \
    processing_system7_0/S_AXI_HP@@hp_index@@_ACLK \
    ${_mem_name}/ACLK \
    ${_mem_name}/S00_ACLK \
    ${_mem_name}/S01_ACLK \
    ${_mem_name}/M00_ACLK \
] {
    vac_connect_net_if_free [list processing_system7_0/FCLK_CLK0 $_p]
}

if {[llength [get_bd_pins -quiet rst_ps7_0_100M/peripheral_aresetn]] > 0} {
    foreach _p [list \
        @@name@@/axi_resetn \
        ${_mem_name}/ARESETN \
        ${_mem_name}/S00_ARESETN \
        ${_mem_name}/S01_ARESETN \
        ${_mem_name}/M00_ARESETN \
    ] {
        set _pin [get_bd_pins -quiet $_p]
        if {[llength $_pin] == 0} { continue }
        if {[llength [get_bd_nets -quiet -of_objects $_pin]] > 0} { continue }
        vac_connect_net_if_free [list rst_ps7_0_100M/peripheral_aresetn $_p]
    }
}

# ---- 数据通路：DMA -> 独立互连 -> PS HP 口 --------------------------------
vac_connect_if_free [list @@name@@/M_AXI_MM2S ${_mem_name}/S00_AXI]
vac_connect_if_free [list @@name@@/M_AXI_S2MM ${_mem_name}/S01_AXI]
vac_connect_if_free [list ${_mem_name}/M00_AXI processing_system7_0/S_AXI_HP@@hp_index@@]

# ---- 自环（loopback=1）：让 S2MM 立刻有数据源，设计可直接通过 validate/门禁 ----
if {@@loopback@@} {
    vac_connect_if_free [list @@name@@/M_AXIS_MM2S @@name@@/S_AXIS_S2MM]
    puts "  \[recipe\] @@name@@ MM2S -> S2MM 自环（接真实数据流时把 loopback 设为 0）"
}

# ---- 控制通路：扩主互连 + 分地址 -----------------------------------------
set _target [get_bd_intf_pins -quiet @@name@@/S_AXI_LITE]
if {[llength $_target] == 0} { fail "@@name@@ 没有 S_AXI_LITE" }
set _already [expr {[llength [get_bd_intf_nets -quiet -of_objects $_target]] > 0}]
if {$_already} {
    puts "  \[recipe\] @@name@@/S_AXI_LITE 已连接，跳过扩互连与分地址"
} else {
    set mi_cur [get_property CONFIG.NUM_MI [get_bd_cells ps7_0_axi_periph]]
    set mi_new [expr {$mi_cur + 1}]
    set_property CONFIG.NUM_MI $mi_new [get_bd_cells ps7_0_axi_periph]
    set mi_idx [format "M%02d" [expr {$mi_new - 1}]]
    vac_connect_net_if_free [list processing_system7_0/FCLK_CLK0 ps7_0_axi_periph/${mi_idx}_ACLK]
    if {[llength [get_bd_pins -quiet rst_ps7_0_100M/peripheral_aresetn]] > 0} {
        vac_connect_net_if_free [list rst_ps7_0_100M/peripheral_aresetn ps7_0_axi_periph/${mi_idx}_ARESETN]
    }
    vac_connect_if_free [list ps7_0_axi_periph/${mi_idx}_AXI @@name@@/S_AXI_LITE]
    vac_ensure_addr @@addr@@ 0x10000 processing_system7_0/Data @@name@@/S_AXI_LITE/Reg
}

# ---- DMA 两个主口都能访问 DDR --------------------------------------------
foreach _space [list @@name@@/Data_MM2S @@name@@/Data_S2MM] {
    vac_ensure_addr 0x00000000 0x40000000 $_space \
        processing_system7_0/S_AXI_HP@@hp_index@@/HP@@hp_index@@_DDR_LOWOCM
}

vac_verify_prop @@name@@ CONFIG.c_include_sg {0}
vac_verify_prop @@name@@ CONFIG.c_sg_length_width {@@length_width@@}
